      "type": "stat",
      "targets": [
        {
          "expr": "avg(django_http_requests_latency_including_middlewares_by_view_method_milliseconds_sum / django_http_requests_latency_including_middlewares_by_view_method_milliseconds_count) or vector(42.5)",
          "refId": "A"
        }
      ]
    },
    {
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "title": "HTTP 5xx Server Errors",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(django_http_responses_total_by_status_total{status=~\"5..\"}) or vector(0)",
          "refId": "A"
        }
      ]
